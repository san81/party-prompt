# Copy to .env and fill in. Never commit .env.

# Option A: OpenRouter (no waitlist). Key from https://openrouter.ai/settings/keys
TYPESAFE_API_KEY=
TYPESAFE_URL=https://openrouter.ai/api/v1/systemone
JEV_MODEL=jev-1.13

# Option B: TypeSafe directly (waitlisted). Comment out Option A's two lines above and use:
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# Auto-score at or above ACCEPT; host asks "Did you mean...?" between CONFIRM and ACCEPT.
ACCEPT_THRESHOLD=0.75
CONFIRM_THRESHOLD=0.45
# One yes/no question per answer so "champagne and fireworks" scores both. Set false to compare.
MULTI_MATCH=true
PORT=3000

# Player feedback and high-fives are posted to this Discord channel webhook (optional).
# Discord: channel ⚙ Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Google Analytics 4 measurement ID (optional). Leave empty locally so testing doesn't count as traffic.
# analytics.google.com → Admin → Data streams → Web → Measurement ID
GA_MEASUREMENT_ID=
